# 复制为项目根目录或 docker/.env 后按需修改
API_KEY=changeme
WEB_PASSWORD=admin-password
LOG_LEVEL=info
PORT=8045
ABV_BIND_LOCAL_ONLY=false
ABV_MAX_BODY_SIZE=104857600
# Windows 建议写绝对路径，例如 C:/Users/你/.antigravity_tools
ABV_HOST_DATA_DIR=~/.antigravity_tools

# --- 与 docker-compose.cursor-relay.yml 同栈时使用 ---
# 对外入口仍是 8045；sidecar 听 8317，仅本机转发。
# CURSOR_RELAY_KEY 默认跟 API_KEY，勿单独改成另一套除非你也改了 Manager 转发逻辑。
# CURSOR_RELAY_KEY=
# CURSOR_ADMIN_PASSWORD=   # 默认跟 WEB_PASSWORD；给 /cursor 管理页用
CURSOR_RENEW_WAIT_S=120
# CURSOR_RELAY_IMAGE=ghcr.io/lyhiving/cursor-relay:latest
# CURSOR_RELAY_PULL=missing   # always | missing | never
